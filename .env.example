# ------------------------------------------------------------------ #
# Supabase — optional.
#
# Without these, Klyro runs every check and produces the full report; it
# simply has no accounts, no saved history and no benchmark. Anonymous
# assessment is the whole product without a database.
# ------------------------------------------------------------------ #
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ------------------------------------------------------------------ #
# Server-only secrets. Never prefixed NEXT_PUBLIC_ — that prefix is what
# tells Next.js to inline a value into the browser bundle.
# ------------------------------------------------------------------ #

# Bypasses row level security completely: every user's assessments, every
# organisation's portfolio, every join code hash. Required for accounts,
# organisations and saved assessments. If this ever appears in a client
# bundle, rotate it immediately in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Join codes are stored as HMAC-SHA256 under this value, so it never enters
# the database — one compromise cannot yield both halves. At least 32 random
# characters. Changing it invalidates every join code already issued.
KLYRO_JOIN_CODE_PEPPER=generate_at_least_32_random_characters

# Guards the dataset seeding route.
KLYRO_ADMIN_TOKEN=any_value_you_choose

# ------------------------------------------------------------------ #
# Upstash Redis — optional, and strongly recommended in production.
#
# Rate limits and the concurrent-scan gate live here so that they are
# shared across Vercel instances and survive a redeploy. Without these,
# Klyro falls back to an in-memory limiter: still bounded, but per
# instance and reset on every deploy, which means the effective limit is
# the configured one multiplied by however many instances are warm.
#
# Local development does not need them. The fallback is a supported
# mode, not a stub.
# ------------------------------------------------------------------ #
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# ------------------------------------------------------------------ #
# Deployment identity
#
# The scanner's User-Agent carries <origin>/scanner, and that URL has to
# resolve to the disclosure page — a "+URL" pointing at a 404 is worse than
# none, because it looks like a scanner trying to appear legitimate.
# ------------------------------------------------------------------ #
NEXT_PUBLIC_SITE_URL=https://klyro.security
NEXT_PUBLIC_SCANNER_CONTACT=abuse@klyro.security

# Optional. Enables the grounded per-finding notes and the one-page
# plain-language summary. Without it the product behaves exactly as it did
# before v1.4.0: the notes are simply absent, and the summary endpoint reports
# that it is unavailable rather than producing an empty document.
GROQ_API_KEY=
# Optional. Overrides the model. Hosted inference services retire models with
# some regularity and this one already happened once: llama-3.3-70b-versatile
# was withdrawn and every call became a 404 that degraded to "no context
# available". Check the account's own list before changing it —
# curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
#
# Do NOT point this at groq/compound or groq/compound-mini. They are agentic
# systems with built-in web search, and a model that can browse would bring in
# facts Klyro never measured — which is the one thing the whole feature exists
# to prevent.
GROQ_MODEL=openai/gpt-oss-120b

# Optional. Caps how many tokens the model may spend thinking before it
# answers. Reasoning tokens count against max_tokens on the gpt-oss family, and
# at the default effort they consume the entire budget and return nothing at
# all. Leave empty to omit the field for a model that does not accept it —
# though the code drops it automatically on a 400 that names it.
GROQ_REASONING_EFFORT=low
